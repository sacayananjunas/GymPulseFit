# Copy to .env and fill in. Never commit .env.

# Neon: console.neon.tech -> your project -> Connect -> copy the postgresql:// string
# Local development without Neon: DATABASE_URL=pglite://.data/pulsefit  (npm run dev fills this in if empty)
DATABASE_URL=

# Long random string used to sign login cookies (npm run dev generates one if empty)
JWT_SECRET=
